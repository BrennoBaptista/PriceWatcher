# Copie para .env e preencha. O .env nao entra no git.

# Bot: @FoscoH_PriceWatcherBot  (token via @BotFather)
TELEGRAM_BOT_TOKEN=coloque-o-token-aqui

# Envie uma mensagem ao bot e leia result[].message.chat.id em:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=coloque-o-chat-id-aqui

# Destino principal: grupo que recebe todos os alertas de preco.
# Crie o grupo, adicione o bot, mande uma mensagem e leia o chat.id no
# getUpdates. Id de grupo e negativo (supergrupo comeca com -100).
TELEGRAM_GROUP_CHAT_ID=

DB_PATH=/data/prices.db
LOG_LEVEL=INFO
TZ=America/Sao_Paulo
